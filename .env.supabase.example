# Copia este archivo como .env.supabase (NO se sube a GitHub) y llena los datos de TU proyecto de Supabase.
# Lo usan solo los scripts que se corren desde tu Mac: migrate-remote.mjs y upload-storage.mjs.

# Supabase → Project Settings → Database → Connection string → "Direct connection" (puerto 5432)
DATABASE_URL_DIRECT=
# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Tu cuenta de Super Admin en la nube (borra la contraseña de aquí cuando entres)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Para conectar los avisos push cuando ya esté publicado en Vercel
APP_URL=
PUSH_WEBHOOK_SECRET=

# ─── Variables del sistema ───────────────────────────────────────────────────
# En tu Mac van en .env.local. En Vercel se capturan en Project → Settings → Environment Variables.

# Base de datos. Mac: Postgres embebido. Vercel: cadena del pooler de Supabase en modo transacción (puerto 6543).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/app

# Dirección pública del sistema
NEXT_PUBLIC_APP_DOMAIN=localhost:3006
NEXT_PUBLIC_APP_URL=http://localhost:3006

# Supabase Storage (fotos). Vacías = se guardan en la carpeta storage/ de tu Mac.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Datos de la plataforma (obligatorios antes de publicar)
NEXT_PUBLIC_APP_NAME=Tu App
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Notificaciones push: genera llaves nuevas para producción con  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@tuapp.com
# Clave que la base de datos usa para avisar al sistema de notificaciones nuevas (texto largo al azar)
PUSH_WEBHOOK_SECRET=
